/** app.wxss **/
page {
  --primary-color: #2d8a3e; /* 价格主题绿 */
  --history-color: #1565c0; /* 历史主题蓝 */
  --trends-color: #6a1b9a; /* 趋势主题紫 */
  
  --bg-color: #f5f6f8;
  --card-bg: #ffffff;
  --text-main: #2c3e50;
  --text-sub: #7f8c8d;
  --border-color: #ebedf0;
  
  --up-color: #e53935; /* 涨红 */
  --down-color: #43a047; /* 跌绿 */
  --steady-color: #757575; /* 持平灰 */
  
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  color: var(--text-main);
  box-sizing: border-box;
}

/* 渐变头部导航占位 */
.nav-header {
  padding: 40rpx 30rpx;
  color: #ffffff;
  display: flex;
  flex-direction: column;
}
.nav-title {
  font-size: 38rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 卡片容器 */
.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

/* 涨跌幅徽章 */
.trend-badge {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.trend-badge.up {
  background: rgba(229, 57, 53, 0.08);
  color: var(--up-color);
}
.trend-badge.down {
  background: rgba(67, 160, 71, 0.08);
  color: var(--down-color);
}
.trend-badge.steady {
  background: rgba(117, 117, 117, 0.08);
  color: var(--steady-color);
}
